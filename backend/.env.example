# Server environment only. Never put a secret in viewer-config.js or commit .env.
MS_TENANT_ID=your-tenant-guid
MS_CLIENT_ID=your-backend-app-guid
MS_CLIENT_SECRET=your-secret-value
SHAREPOINT_HOST=netorgft12597064-my.sharepoint.com
# Accept changing public links from SHAREPOINT_HOST without listing each file.
# The service verifies Graph permission AND an anonymous file download.
ALLOW_DYNAMIC_PUBLIC_LINKS=true
# Optional: only required if dynamic links are disabled. Use exact Share > Copy links.
PUBLIC_SHARE_LINKS=[]
ALLOWED_ORIGINS=https://ayush-wootz.github.io
CACHE_TTL_SECONDS=300
MAX_FILE_MB=20
MAX_CACHE_MB=128
MAX_CACHE_ENTRIES=200
MAX_CONCURRENT_FETCHES=4
PORT=8080
