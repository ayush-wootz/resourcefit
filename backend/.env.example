# Server environment only. Never put a secret in viewer-config.js or commit .env.
MS_TENANT_ID=your-tenant-guid
MS_CLIENT_ID=your-backend-app-guid
MS_CLIENT_SECRET=your-secret-value
SHAREPOINT_HOST=netorgft12597064-my.sharepoint.com
# JSON array of exact, password-free Anyone sharing URLs approved for this viewer.
# Use Share > Copy link, not a Doc.aspx browser address. Keep query parameters intact.
PUBLIC_SHARE_LINKS=["https://netorgft12597064-my.sharepoint.com/:i:/g/personal/rfq_wootz_work/REPLACE_WITH_SHARING_TOKEN"]
ALLOWED_ORIGINS=https://ayush-wootz.github.io
CACHE_TTL_SECONDS=300
MAX_FILE_MB=20
MAX_CACHE_MB=128
MAX_CONCURRENT_FETCHES=4
PORT=8080
